# =========================
# Arquivos de Ambiente / Segurança
# =========================
.env
.env.*

# =========================
# Ambientes Virtuais (Pesados e Locais)
# =========================
venv/
env/
.venv/

# =========================
# Python / Flask
# =========================
# Arquivos compilados automaticamente pelo Python
__pycache__/
*.py[cod]
*$py.class

# Pastas de cache e testes
.pytest_cache/
.coverage
instance/

# =========================
# Dados e Simulação (Arquivos Massivos)
# =========================
# Ignora a pasta inteira onde o gerador salva o arquivo gigante
edge_simulation/data/

# Ignora arquivos CSV e de log em qualquer lugar do projeto
*.csv
*.log

# =========================
# Configurações de SO e Editores (VS Code, etc)
# =========================
# Evita subir arquivos inúteis do sistema operacional e da IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# =========================
# Frontend (Angular / Node.js)
# =========================
# Se o frontend estiver no mesmo repositório, não subir os pacotes baixados
frontend_app/node_modules/
frontend_app/dist/
frontend_app/.angular/